# Copiar a .env y completar. .env nunca se commitea.

# Webhook de Discord para el resumen mensual (opcional).
DISCORD_WEBHOOK_URL=

# Aporte mensual en moneda local y reparto por horizonte.
APORTE_MENSUAL_ARS=0
HORIZONTE_LARGO_PCT=80
HORIZONTE_CORTO_PCT=20

# Colchon de emergencia: gastos mensuales x meses.
# Es el unico numero que ningun reporte puede calcular solo.
# Si queda vacio, el reporte lo marca como hueco abierto en vez de estimarlo.
COLCHON_MESES=
GASTOS_MENSUALES_USD=

# Tenencias. El reporte recalcula el rendimiento efectivo sobre estos montos,
# aplicando el escalon de 200 unidades de Binance.
BINANCE_EARN_TOTAL_USD=0
BINANCE_USDT_SIMPLE_EARN=0
BINANCE_USDT_RECOMPENSA_DIARIA=0
BINANCE_USDT_ACUMULADO_DESDE_2023=0
BINANCE_USDT_EFECTIVO_OBSERVADO_PCT=

RESTO_USD=0
RESTO_RENDIMIENTO_IMPLICITO_PCT=
RESTO_COMPOSICION=DESCONOCIDA

# Nexo: el sitio publico solo muestra maximos de nivel Platinum.
# La tasa real por nivel se lee en platform.nexo.com/savings-breakdown (logueado).
NEXO_NIVEL=Base
NEXO_USDT_FLEXIBLE_BASE_PCT=
NEXO_USDT_FIXED_BASE_PCT=
NEXO_USDC_FLEXIBLE_BASE_PCT=
NEXO_USDC_FIXED_BASE_PCT=
NEXO_BONO_PAGO_EN_NEXO_PCT=
